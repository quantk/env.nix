{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 10,

  "modules-left": ["network", "cpu", "memory", "bandwidth"],
  "modules-center": ["hyprland/workspaces", "clock"],
  "modules-right": ["mpris", "pulseaudio", "tray"],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "hyprctl dispatch workspace {name}",
    "disable-scroll": true
  },

  "clock": {
    "format": "{:%a %d.%m  %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>",
    "on-click": "gnome-calendar",
    "tooltip": true
  },

  "mpris": {
    "format": " {player_icon} {artist} - {title}",
    "format-paused": " {player_icon} {artist} - {title} (paused)",
    "player-icons": {
      "spotify": "",
      "default": ""
    },
    "status-icons": {
      "paused": "",
      "playing": "",
      "stopped": ""
    },
    "tooltip": true,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-scroll-up": "playerctl previous",
    "on-scroll-down": "playerctl next",
    "max-length": 45
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%-"
  },

  "tray": {
    "spacing": 8
  },

  "network": {
    "format-wifi": " {signalStrength}%  󰇚 {bandwidthDownBytes} 󰕒 {bandwidthUpBytes}",
    "format-ethernet": "󰈀 {ipaddr}  󰇚 {bandwidthDownBytes} 󰕒 {bandwidthUpBytes}",
    "interval": 2,
    "format-linked": "󰈀 {ifname} 󰇚 {bandwidthDownBytes} 󰕒 {bandwidthUpBytes}",
    "format-disconnected": "󰤮",
    "tooltip": true,
    "tooltip-format-wifi": " {essid}\n{ipaddr}\n{frequency} MHz\n{signalStrength}% ({signalLevel} dBm)",
    "tooltip-format-ethernet": "󰈀 {ifname}\n{ipaddr}",
    "on-click": "nm-connection-editor"
  },

  "bandwidth": {
    "interface": "auto",
    "format": "󰇚 {downloadBandwidthBits} 󰕒 {uploadBandwidthBits}",
    "interval": 1,
    "tooltip": true
  },

  "cpu": {
    "format": " {usage}%",
    "tooltip": true
  },

  "memory": {
    "format": " {percentage}%",
    "tooltip": true,
    "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G"
  }
}

