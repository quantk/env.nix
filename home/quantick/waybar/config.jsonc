{
  "layer": "top",
  "position": "top",
  "height": 50,
  "spacing": 10,

  "modules-left": ["cpu", "memory", "network"],
  "modules-center": ["hyprland/workspaces", "clock", "custom/weather"],
  "modules-right": ["mpris", "pulseaudio", "tray", "hyprland/language"],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "hyprctl dispatch workspace {name}",
    "disable-scroll": true
  },

  "clock": {
    "format": "{:%a %d.%m  %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>",
    "on-click": "thunderbird -calendar",
    "tooltip": true
  },

  "mpris": {
    "format": " {player_icon} {artist} - {title}",
    "format-paused": " {player_icon} {artist} - {title} (paused)",
    "player-icons": {
      "spotify": "",
      "default": ""
    },
    "status-icons": {
      "paused": "",
      "playing": "",
      "stopped": ""
    },
    "tooltip": true,
    "on-click": "playerctl next",
    "on-click-right": "playerctl previous",
    "on-click-middle": "playerctl play-pause",
    "max-length": 45
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%-"
  },

  "tray": {
    "spacing": 8
  },

  "network": {
    "format-wifi": " {signalStrength}%  󰇚 {bandwidthDownBytes} 󰕒 {bandwidthUpBytes}",
    "format-ethernet": "󰈀 {ipaddr}  󰇚 {bandwidthDownBytes} 󰕒 {bandwidthUpBytes}",
    "interval": 2,
    "format-linked": "󰈀 {ifname} 󰇚 {bandwidthDownBytes} 󰕒 {bandwidthUpBytes}",
    "format-disconnected": "󰤮",
    "tooltip": true,
    "tooltip-format-wifi": " {essid}\n{ipaddr}\n{frequency} MHz\n{signalStrength}% ({signalLevel} dBm)",
    "tooltip-format-ethernet": "󰈀 {ifname}\n{ipaddr}",
    "on-click": "nm-connection-editor"
  },

  "cpu": {
    "format": " {usage}%",
    "tooltip": true
  },

  "memory": {
    "format": " {percentage}%",
    "tooltip": true,
    "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G"
  },

  "custom/weather": {
    "exec": "~/.config/waybar/scripts/wttr.sh",
    "return-type": "json",
    "interval": 1200,
    "format": "{}",
    "signal": 8,
    "on-click": "pkill -SIGRTMIN+8 waybar",
    "tooltip": true
  },

  "hyprland/language": {
    "format": "{}",
    "format-en": "🇺🇸 EN",
    "format-ru": "🇷🇺 RU",
    "on-click": "hyprctl switchxkblayout logitech-usb-keyboard next",
    "tooltip": false
  }

}

